# Copie este arquivo para ".env" e preencha. Nunca comite o ".env" de verdade.

# --- Travelpayouts / Aviasales Data API (espinha dorsal atual — grátis, sem
# verificação de negócio) ---
# https://www.travelpayouts.com/programs/100/tools/api -> pegue o token, grátis
TRAVELPAYOUTS_TOKEN=

# --- Duffel (mantido só pro caso de conseguir sair do modo teste — pra
# pessoa física o "Go live" pede verificação que normalmente não passa) ---
# https://duffel.com/
DUFFEL_ACCESS_TOKEN=

# --- Amadeus for Developers (self-service fechado pra devs novos desde 17/07/2026) ---
# Só preencha se você já tinha uma conta/chave de antes do fechamento.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Kiwi.com Tequila API (opcional, hoje só por convite pra devs novos) ---
# https://tequila.kiwi.com/portal/login
KIWI_API_KEY=

# --- SerpApi (Google Voos real, via busca de verdade) ---
# https://serpapi.com/users/sign_up -> plano grátis: 100 buscas/mês
SERPAPI_KEY=

# --- Telegram Bot (grátis) ---
# Fale com @BotFather no Telegram -> /newbot -> copie o token.
# Depois mande "oi" pro bot e acesse https://api.telegram.org/bot<TOKEN>/getUpdates
# pra pegar o chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-mail (SMTP) ---
# Gmail: ative verificação em 2 etapas e gere uma "senha de app" em
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=mvapessanha@gmail.com
